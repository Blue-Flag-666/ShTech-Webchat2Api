HOST=127.0.0.1
PORT=8787
# 网站 x-access-token，仅保存在本地 .env
GENAI_TOKEN=
# 可选 CAS 登录（支持自动刷新）；也支持 GENAI_PASSWORD_FILE 等 _FILE 变量
GENAI_USERNAME=
GENAI_PASSWORD=
# 可选：若上游依赖 Cookie，再填写
GENAI_COOKIE=
# 图片上传请求中的 token；仅在使用图片输入时需要
GENAI_UPLOAD_TOKEN=
# 可选；通常可省略，仅在上游账号要求固定网页会话时填写
GENAI_CHAT_GROUP_ID=
# 客户端访问本地 API 的独立密钥
API_KEY=
GENAI_NET_GO=false
GENAI_TIMEOUT_MS=120000
GENAI_MODEL_TTL_MS=300000
GENAI_CONCURRENCY=1
GENAI_QUEUE_SIZE=32
GENAI_QUEUE_TIMEOUT_MS=120000
GENAI_REQUEST_LIMIT_MB=144
GENAI_RESPONSE_STORE_SIZE=128
GENAI_RESPONSE_STORE_TTL_MS=3600000
GENAI_UPSTREAM_RETRIES=2
# 浏览器客户端需要时填写完整来源，例如 http://127.0.0.1:3000
CORS_ORIGIN=
