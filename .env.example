HOST=127.0.0.1
PORT=8787
# 网站 x-access-token，仅保存在本地 .env
GENAI_TOKEN=
# 可选 CAS 登录（支持自动刷新）；也支持 GENAI_PASSWORD_FILE 等 _FILE 变量
GENAI_USERNAME=
GENAI_PASSWORD=
# 可选：若上游依赖 Cookie，再填写
GENAI_COOKIE=
# 从网页请求中获取；尚未确认是否允许省略或自行创建
GENAI_CHAT_GROUP_ID=
# 客户端访问本地 API 的独立密钥
API_KEY=
GENAI_NET_GO=false
GENAI_TIMEOUT_MS=120000
